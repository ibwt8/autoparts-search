{
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "endOfLine": "lf",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react(?:$|[-/])",
    "<THIRD_PARTY_MODULES>",
    "^(?:\\.{1,2}/)+app(?:/|$)",
    "^(?:\\.{1,2}/)+modules(?:/|$)",
    "^(?:\\.{1,2}/)+shared(?:/|$)",
    "^(?!.*\\.(?:css|scss)$)\\.",
    "\\.(?:css|scss)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderSideEffects": false
}
